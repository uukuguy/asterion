{
  "name": "@asterion/prime-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.contract.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "npm run build && node --test test/ipython-extension.test.mjs test/context-witness.test.mjs test/context-memory.test.mjs test/tool-state-view.test.mjs test/provider-prefix-metrics.test.mjs",
    "test:installed-pi": "npm run build && node test/installed-pi-memory-probe.mjs",
    "sync-resource": "npm run build && node scripts/sync-runtime-resource.mjs --write",
    "check-resource": "npm run build && node scripts/sync-runtime-resource.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
