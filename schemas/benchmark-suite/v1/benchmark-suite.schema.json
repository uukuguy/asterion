{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/benchmark-suite/v1/benchmark-suite.schema.json",
  "title": "Asterion Benchmark Suite Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "suite_id",
    "version",
    "owner_package",
    "tasks",
    "artifact_media_types",
    "default_case_limit",
    "default_concurrency"
  ],
  "properties": {
    "protocol": {"const": "asterion.benchmark-suite/v1"},
    "suite_id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/version"},
    "owner_package": {"$ref": "#/$defs/capability_package_ref"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-asterion-sorted-unique": ["task_id"],
      "items": {"$ref": "#/$defs/task"}
    },
    "artifact_media_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-asterion-sorted-unique": true,
      "items": {"$ref": "#/$defs/media_type"}
    },
    "default_case_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "default_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "scalar_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])[\\s\\S]+$"
    },
    "public_note": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])[\\s\\S]*$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
    },
    "capability_package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "version"],
      "properties": {
        "package_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "capability_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "capability",
        "binding_id",
        "metric_contract_id",
        "result_contract_id",
        "note"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"},
        "capability": {"$ref": "#/$defs/capability_ref"},
        "binding_id": {"$ref": "#/$defs/identifier"},
        "metric_contract_id": {"$ref": "#/$defs/scalar_text"},
        "result_contract_id": {"$ref": "#/$defs/scalar_text"},
        "note": {"$ref": "#/$defs/public_note"}
      }
    }
  }
}
