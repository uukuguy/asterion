{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/operation/v1/operation-receipt.schema.json",
  "title": "Asterion Operation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "receipt_id", "operation_id", "request_ref", "request_sha256", "purpose", "session_id", "client_id", "generation", "authority_revision", "authority_id", "idempotency_key", "feature_id", "status", "reason_code", "receipt_ref", "reconciliation_ref", "effect_counts", "completed_at"],
  "properties": {
    "protocol": {"const": "asterion.operation/v1"},
    "receipt_id": {"$ref": "#/$defs/opaque_id"},
    "operation_id": {"$ref": "#/$defs/opaque_id"},
    "request_ref": {"$ref": "#/$defs/opaque_id"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "purpose": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/opaque_id"},
    "client_id": {"$ref": "#/$defs/opaque_id"},
    "generation": {"$ref": "#/$defs/positive_integer"},
    "authority_revision": {"$ref": "#/$defs/positive_integer"},
    "authority_id": {"$ref": "#/$defs/opaque_id"},
    "idempotency_key": {"$ref": "#/$defs/opaque_id"},
    "feature_id": {"$ref": "#/$defs/feature_id"},
    "status": {"enum": ["succeeded", "rejected", "failed", "cancelled", "uncertain"]},
    "reason_code": {"$ref": "#/$defs/identifier"},
    "receipt_ref": {"$ref": "#/$defs/opaque_id"},
    "reconciliation_ref": {"oneOf": [{"$ref": "#/$defs/opaque_id"}, {"type": "null"}]},
    "effect_counts": {"$ref": "#/$defs/effect_counts"},
    "completed_at": {"$ref": "#/$defs/utc_timestamp"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "nonnegative_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "feature_id": {"enum": ["operation.auth", "operation.controlled-update-restart", "operation.doctor", "operation.model-selection", "operation.settings-keybindings", "operation.telemetry-usage"]},
    "utc_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "effect_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_value_reads", "provider_model_requests", "network_operations", "package_manager_operations", "os_process_restart_operations", "external_telemetry_deliveries", "uploads"],
      "properties": {
        "credential_value_reads": {"$ref": "#/$defs/nonnegative_integer"},
        "provider_model_requests": {"$ref": "#/$defs/nonnegative_integer"},
        "network_operations": {"$ref": "#/$defs/nonnegative_integer"},
        "package_manager_operations": {"$ref": "#/$defs/nonnegative_integer"},
        "os_process_restart_operations": {"$ref": "#/$defs/nonnegative_integer"},
        "external_telemetry_deliveries": {"$ref": "#/$defs/nonnegative_integer"},
        "uploads": {"$ref": "#/$defs/nonnegative_integer"}
      }
    }
  }
}
