{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/capability-source/v1/lock.schema.json",
  "$comment": "Canonical ordering is a protocol semantic gate above structural JSON Schema: protocol validators MUST enforce Unicode scalar ascending order by (package_id, version, payload_sha256, source_id) and uniqueness by exact package ref.",
  "title": "Asterion Capability Source Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "entries"],
  "properties": {
    "protocol": {"const": "asterion.capability-lock/v1"},
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "version"],
      "properties": {
        "package_id": {"$ref": "#/$defs/identity"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_ref", "payload_sha256", "source_id"],
      "properties": {
        "package_ref": {"$ref": "#/$defs/package_ref"},
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_id": {"$ref": "#/$defs/identity"}
      }
    }
  }
}
