{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/agent-system/v1/agent-system.schema.json",
  "title": "Asterion Agent System v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "system_id",
    "version",
    "control_plane",
    "applications",
    "policies",
    "host_capabilities",
    "control_capabilities"
  ],
  "properties": {
    "protocol": {"const": "asterion.agent-system/v1"},
    "system_id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/version"},
    "control_plane": {"$ref": "#/$defs/control_plane_ref"},
    "applications": {
      "$comment": "Validators enforce Unicode-scalar ascending order by provider_id, application_id, version and runtime_id.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/application_ref"}
    },
    "policies": {"$ref": "#/$defs/identifiers"},
    "host_capabilities": {"$ref": "#/$defs/identifiers"},
    "control_capabilities": {"$ref": "#/$defs/identifiers"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "control_plane_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_plane_id", "version"],
      "properties": {
        "control_plane_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "application_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "application_id", "version", "runtime_id"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/identifier"},
        "application_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "runtime_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "identifiers": {
      "$comment": "Validators enforce Unicode-scalar ascending order and uniqueness.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    }
  }
}
