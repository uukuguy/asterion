{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/application-assembly/v1/application-assembly.schema.json",
  "title": "Asterion Application Assembly v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "application_id",
    "version",
    "runtime_id",
    "capability_packages",
    "capabilities",
    "host_capabilities",
    "host_policies",
    "host_events",
    "host_artifacts"
  ],
  "properties": {
    "protocol": {"const": "asterion.application-assembly/v1"},
    "application_id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/version"},
    "runtime_id": {"$ref": "#/$defs/identifier"},
    "capability_packages": {
      "$comment": "Canonical ordering is a protocol semantic gate above structural JSON Schema: protocol validators MUST enforce Unicode-scalar ascending order by (package_id, version) and uniqueness.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/package_ref"}
    },
    "capabilities": {
      "$comment": "Canonical ordering is a protocol semantic gate above structural JSON Schema: protocol validators MUST enforce Unicode-scalar ascending order by (capability_id, version) and uniqueness.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability_ref"}
    },
    "host_capabilities": {"$ref": "#/$defs/edges"},
    "host_policies": {"$ref": "#/$defs/edges"},
    "host_events": {"$ref": "#/$defs/edges"},
    "host_artifacts": {"$ref": "#/$defs/edges"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "version"],
      "properties": {
        "package_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "capability_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "edges": {
      "$comment": "Canonical ordering is a protocol semantic gate above structural JSON Schema: protocol validators MUST enforce Unicode-scalar ascending string order and uniqueness.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])[\\s\\S]+$"
      },
      "uniqueItems": true
    }
  }
}
