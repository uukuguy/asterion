{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/agent-control/v1/event.schema.json",
  "title": "Asterion Agent Control Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "event_id",
    "session_id",
    "generation",
    "sequence",
    "emitted_at",
    "type",
    "payload"
  ],
  "properties": {
    "protocol": {"const": "asterion.agent-control/v1"},
    "event_id": {"$ref": "#/$defs/opaque_id"},
    "session_id": {"$ref": "#/$defs/opaque_id"},
    "generation": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "emitted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "type": {
      "enum": [
        "action.proposed",
        "budget.reported",
        "checkpoint.created",
        "fault.raised",
        "goal.updated",
        "session.budget-limited",
        "session.cancelled",
        "session.completed",
        "session.created",
        "session.failed",
        "session.paused",
        "session.recovery-required",
        "session.running"
      ]
    },
    "payload": {}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "type": {"const": "session.created"},
            "payload": {"$ref": "#/$defs/session_created"}
          }
        },
        {
          "properties": {
            "type": {"const": "session.running"},
            "payload": {"$ref": "#/$defs/reason"}
          }
        },
        {
          "properties": {
            "type": {"const": "session.paused"},
            "payload": {"$ref": "#/$defs/reason"}
          }
        },
        {
          "properties": {
            "type": {"const": "session.recovery-required"},
            "payload": {"$ref": "#/$defs/reason"}
          }
        },
        {
          "properties": {
            "type": {"const": "session.completed"},
            "payload": {"$ref": "#/$defs/reason"}
          }
        },
        {
          "properties": {
            "type": {"const": "session.failed"},
            "payload": {"$ref": "#/$defs/reason"}
          }
        },
        {
          "properties": {
            "type": {"const": "session.cancelled"},
            "payload": {"$ref": "#/$defs/reason"}
          }
        },
        {
          "properties": {
            "type": {"const": "session.budget-limited"},
            "payload": {"$ref": "#/$defs/reason"}
          }
        },
        {
          "properties": {
            "type": {"const": "goal.updated"},
            "payload": {"$ref": "#/$defs/goal_updated"}
          }
        },
        {
          "properties": {
            "type": {"const": "action.proposed"},
            "payload": {"$ref": "#/$defs/action_proposed"}
          }
        },
        {
          "properties": {
            "type": {"const": "checkpoint.created"},
            "payload": {"$ref": "#/$defs/checkpoint_created"}
          }
        },
        {
          "properties": {
            "type": {"const": "budget.reported"},
            "payload": {"$ref": "#/$defs/usage"}
          }
        },
        {
          "properties": {
            "type": {"const": "fault.raised"},
            "payload": {"$ref": "#/$defs/fault"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code"],
      "properties": {
        "reason_code": {"$ref": "#/$defs/identifier"}
      }
    },
    "session_created": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "authority_id", "authority_revision"],
      "properties": {
        "goal_id": {"$ref": "#/$defs/opaque_id"},
        "authority_id": {"$ref": "#/$defs/opaque_id"},
        "authority_revision": {"type": "integer", "minimum": 1}
      }
    },
    "goal_updated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "status"],
      "properties": {
        "goal_id": {"$ref": "#/$defs/opaque_id"},
        "status": {
          "enum": [
            "active",
            "paused",
            "needs_input",
            "budget_limited",
            "completed",
            "failed",
            "cancelled"
          ]
        }
      }
    },
    "action_proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "idempotency_key",
        "kind",
        "target",
        "input_ref",
        "expected_artifacts",
        "budget",
        "causal_parent_ids"
      ],
      "properties": {
        "action_id": {"$ref": "#/$defs/opaque_id"},
        "idempotency_key": {"$ref": "#/$defs/opaque_id"},
        "kind": {
          "enum": [
            "application.invoke",
            "checkpoint.create",
            "child.cancel",
            "child.message",
            "child.spawn",
            "goal.complete",
            "goal.fail",
            "input.request",
            "session.pause"
          ]
        },
        "target": {"$ref": "#/$defs/action_target"},
        "input_ref": {"$ref": "#/$defs/opaque_id"},
        "expected_artifacts": {"$ref": "#/$defs/identifiers"},
        "budget": {"$ref": "#/$defs/budget"},
        "causal_parent_ids": {"$ref": "#/$defs/opaque_ids"}
      }
    },
    "action_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provider_id", "application_id", "version", "runtime_id"],
          "properties": {
            "kind": {"const": "application"},
            "provider_id": {"$ref": "#/$defs/identifier"},
            "application_id": {"$ref": "#/$defs/identifier"},
            "version": {"$ref": "#/$defs/version"},
            "runtime_id": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "child_id"],
          "properties": {
            "kind": {"const": "child"},
            "child_id": {"$ref": "#/$defs/opaque_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "checkpoint_id"],
          "properties": {
            "kind": {"const": "checkpoint"},
            "checkpoint_id": {"$ref": "#/$defs/opaque_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "goal_id"],
          "properties": {
            "kind": {"const": "goal"},
            "goal_id": {"$ref": "#/$defs/opaque_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "request_id"],
          "properties": {
            "kind": {"const": "input"},
            "request_id": {"$ref": "#/$defs/opaque_id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "session_id"],
          "properties": {
            "kind": {"const": "session"},
            "session_id": {"$ref": "#/$defs/opaque_id"}
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_tokens",
        "application_tokens",
        "child_tokens",
        "aggregate_tokens",
        "cost_micros",
        "deadline_ms"
      ],
      "properties": {
        "controller_tokens": {"type": "integer", "minimum": 0},
        "application_tokens": {"type": "integer", "minimum": 0},
        "child_tokens": {"type": "integer", "minimum": 0},
        "aggregate_tokens": {"type": "integer", "minimum": 0},
        "cost_micros": {"type": "integer", "minimum": 0},
        "deadline_ms": {"type": "integer", "minimum": 1}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller_tokens",
        "application_tokens",
        "child_tokens",
        "aggregate_tokens",
        "cost_micros"
      ],
      "properties": {
        "controller_tokens": {"type": "integer", "minimum": 0},
        "application_tokens": {"type": "integer", "minimum": 0},
        "child_tokens": {"type": "integer", "minimum": 0},
        "aggregate_tokens": {"type": "integer", "minimum": 0},
        "cost_micros": {"type": "integer", "minimum": 0}
      }
    },
    "checkpoint_created": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "capsule_id",
        "capsule_digest",
        "control_plane_id",
        "control_plane_version",
        "checkpoint_version",
        "covered_sequence",
        "storage_ref"
      ],
      "properties": {
        "checkpoint_id": {"$ref": "#/$defs/opaque_id"},
        "capsule_id": {"$ref": "#/$defs/opaque_id"},
        "capsule_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "control_plane_id": {"$ref": "#/$defs/identifier"},
        "control_plane_version": {"$ref": "#/$defs/version"},
        "checkpoint_version": {"$ref": "#/$defs/version"},
        "covered_sequence": {"type": "integer", "minimum": 1},
        "storage_ref": {"$ref": "#/$defs/opaque_id"}
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "recoverable", "evidence_ref"],
      "properties": {
        "code": {"$ref": "#/$defs/identifier"},
        "recoverable": {"type": "boolean"},
        "evidence_ref": {
          "oneOf": [
            {"$ref": "#/$defs/opaque_id"},
            {"type": "null"}
          ]
        }
      }
    },
    "identifiers": {
      "$comment": "Validators enforce Unicode-scalar ascending order and uniqueness.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "opaque_ids": {
      "$comment": "Validators enforce Unicode-scalar ascending order and uniqueness.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaque_id"}
    }
  }
}
