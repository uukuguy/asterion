{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/capabilities/v1/capability-manifest.schema.json",
  "title": "Asterion Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "capability_id", "version", "kind",
    "provides_capabilities", "requires_capabilities", "requires_policies",
    "emits_events", "consumes_events", "produces_artifacts", "consumes_artifacts"
  ],
  "properties": {
    "protocol": {"const": "asterion.capability/v1"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "kind": {"enum": ["capability", "research", "workflow", "policy", "memory", "observability", "evaluation"]},
    "provides_capabilities": {"$ref": "#/$defs/edges"},
    "requires_capabilities": {"$ref": "#/$defs/edges"},
    "requires_policies": {"$ref": "#/$defs/edges"},
    "emits_events": {"$ref": "#/$defs/edges"},
    "consumes_events": {"$ref": "#/$defs/edges"},
    "produces_artifacts": {"$ref": "#/$defs/edges"},
    "consumes_artifacts": {"$ref": "#/$defs/edges"}
  },
  "$defs": {
    "edges": {
      "type": "array",
      "x-asterion-sorted-unique": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])[\\s\\S]+$"
      },
      "uniqueItems": true
    }
  }
}
