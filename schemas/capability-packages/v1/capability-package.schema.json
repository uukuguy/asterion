{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asterion.local/schemas/capability-packages/v1/capability-package.schema.json",
  "title": "Asterion Capability Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "package_id",
    "version",
    "capabilities",
    "benchmark_suites",
    "resources"
  ],
  "properties": {
    "protocol": {"const": "asterion.capability-package/v1"},
    "package_id": {"$ref": "#/$defs/identity"},
    "version": {"$ref": "#/$defs/version"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability_ref"}
    },
    "benchmark_suites": {
      "type": "array",
      "maxItems": 0
    },
    "resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/resource_identity"}
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "capability_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/identity"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "resource_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "media_type", "sha256"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/identity"},
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
